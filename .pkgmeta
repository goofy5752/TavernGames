package-as: TavernGames

# The release notes the packager hands to CurseForge and GitHub.
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# Every tag is the exact version vendored under Libs/ (LICENSE-THIRD-PARTY.md).
externals:
  Libs/LibStub:
    url: https://repos.wowace.com/wow/ace3/trunk/LibStub
    tag: Release-r1403
  Libs/CallbackHandler-1.0:
    url: https://repos.wowace.com/wow/ace3/trunk/CallbackHandler-1.0
    tag: Release-r1403
  Libs/AceAddon-3.0:
    url: https://repos.wowace.com/wow/ace3/trunk/AceAddon-3.0
    tag: Release-r1403
  Libs/AceComm-3.0:
    url: https://repos.wowace.com/wow/ace3/trunk/AceComm-3.0
    tag: Release-r1403
  Libs/AceSerializer-3.0:
    url: https://repos.wowace.com/wow/ace3/trunk/AceSerializer-3.0
    tag: Release-r1403
  Libs/AceDB-3.0:
    url: https://repos.wowace.com/wow/ace3/trunk/AceDB-3.0
    tag: Release-r1403
  Libs/LibDeflate:
    url: https://github.com/SafeteeWoW/LibDeflate
    tag: 1.0.2-release
  Libs/LibDataBroker-1.1:
    url: https://github.com/tekkub/libdatabroker-1-1
    tag: v1.1.4
  Libs/LibDBIcon-1.0:
    url: https://repos.wowace.com/wow/libdbicon-1-0/trunk/LibDBIcon-1.0
    tag: v12.1.2

ignore:
  - docs
  - tests
  - tools
  - t.sh
  - .github
  - CONTRIBUTING.md
  - CODE_OF_CONDUCT.md
  - SECURITY.md
